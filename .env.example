# =====================================================================
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — your secrets stay on your machine.
# After editing .env.local, restart `npm run dev` so Next.js picks it up.
# =====================================================================

# --- Brevo (email signups for the free Minecraft books) --------------
# Get your API key:  Brevo dashboard → top-right menu → SMTP & API →
#                    API Keys → "Generate a new API key"
BREVO_API_KEY=xkeysib-replace-me

# Numeric ID of the "Minecraft" list:
#   Brevo dashboard → Contacts → Lists → click "Minecraft"
#   The ID appears in the URL (e.g. /lists/3 means ID 3)
BREVO_LIST_ID=3

# Where to send subscribers after they successfully sign up:
NEXT_PUBLIC_BOOKFUNNEL_URL=https://books.bookfunnel.com/2freeminecraftbooks

# --- Fan fiction submissions (Gmail SMTP) ---------------------------
# Uses your Gmail account to send notification emails (free, no
# subscription). Requires an App Password — generate one at:
#   https://myaccount.google.com/apppasswords
# (requires 2FA on the Gmail account)
GMAIL_USER=marktheminecraftauthor@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where new-story notifications are sent (any inbox you check):
FANFIC_NOTIFY_TO=mark.cheverton@gameknightpublishing.com

# --- Phase 6: comment moderation (Supabase) -------------------------
# 1. Create a free project at https://supabase.com
# 2. Project Settings → API → copy these three values:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
# 3. Open Supabase SQL Editor and paste migration/supabase-schema.sql
#    Then click Run. (Safe to re-run.)

# Password gating /admin/* pages. Pick something strong (12+ chars).
# When you change this, all current admin sessions invalidate.
ADMIN_PASSWORD=change-me-to-something-strong

# Email address that can receive magic sign-in links via /admin/forgot.
# If unset, falls back to FANFIC_NOTIFY_TO above.
# ADMIN_EMAIL=marktheminecraftauthor@gmail.com

# Public site URL used in email moderation links. In dev use
# http://localhost:3000; in production use https://www.markcheverton.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
